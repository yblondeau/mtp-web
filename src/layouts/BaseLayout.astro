---
import "../styles/globals.css";
import { SITE } from "../lib/constants";
const { title = SITE.name, description = SITE.description } = Astro.props;
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={`${SITE.base}favicon.svg`} />
    <style is:global>
      html, body {
        background-color: #0f1310;
        background-image: url("images/asphalt-texture.png");
        background-size: 512px 512px;
        background-repeat: repeat;
        background-attachment: fixed;
      }
    </style>
  </head>
  <body class="text-foreground antialiased">
    <slot />
  </body>
</html>
