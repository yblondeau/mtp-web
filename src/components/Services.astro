---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { ACTIVITIES } from '../lib/constants';
---

{ACTIVITIES.map((a, i) => {
  const imageLeft = i % 2 === 0;
  const bottomClass = i % 2 === 0 ? 'diag-bottom-a' : 'diag-bottom-b';
  const altBg = `service-alt-${i % 2}`; // used for debugging only
  const topClass = (i - 1) % 2 === 0 ? 'diag-top-a' : 'diag-top-b';
  const imgDiag = i % 2 === 0 ? 'img-diag-bottom-a' : 'img-diag-bottom-b';

  return (
    <section class={`service-row ${altBg}`}>
      <div class={"overflow-hidden"}>
        <div class={`service-shell ${topClass}`}>
          <div class={`service-inner ${bottomClass}`}>
            <div class={`grid md:grid-cols-2 items-stretch`}>
              {/* Bloc image (1/2) */}
              <div class={`${imageLeft ? '' : 'md:order-2'}`}>
                <div class={`h-full min-h-[340px] md:min-h-[420px] ${imgDiag}`}>
                  <Image
                    src={a.img}
                    alt={a.title}
                    width={900}
                    class="w-full h-full object-cover"
                    loading="lazy" />
                </div>
              </div>
              {/* Bloc texte (1/2) */}
              <div class={`${imageLeft ? '' : 'md:order-1'} flex items-center justify-center`}>
                <div class="service-card max-w-xl" data-reveal>
                  <h3 class="text-2xl md:text-3xl font-semibold">{a.title}</h3>
                  <p class="mt-4 opacity-80">{a.desc}</p>

                  {a.subs && a.subs.length > 0 && (
                    <ul class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-3">
                      {a.subs.map((s) => (
                        <li class="flex flex-col items-center justify-start gap-2">
                          <Icon name={s} />
                          <span class="text-sm md:text-base">{s}</span>
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  );
})}
