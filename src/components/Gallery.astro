---
import { Image } from "astro:assets";
import { GALLERY_IMAGES } from "../lib/constants";
---

<section id="galerie" class="py-20 md:py-28">
  <div class="container">
    <header>
      <h2 class="text-3xl md:text-5xl font-bold split-lines" data-reveal>
        Réalisations
      </h2>
      <p class="mt-4 text-muted" data-reveal>
        Interventions soignées et sécurisées, du devis à la réception de chantier.
      </p>
    </header>
    <div class="mt-10 grid grid-cols-2 md:grid-cols-4 gap-3" data-reveal>
      {GALLERY_IMAGES.map((photo) => (
        <Image
          src={photo.src}
          alt={photo.alt}
          width={640}
          class="rounded-xl border border-white/10"
          loading="lazy"
        />
      ))}
    </div>
  </div>
</section>
