---
const { title, desc, img } = Astro.props as {
  title: string;
  desc: string;
  img: string;
};
---

<article
  class="group rounded-3xl overflow-hidden border border-white/10 bg-white/5"
>
  <div class="aspect-[4/3] overflow-hidden">
    <img
      src={img}
      alt=""
      class="w-full h-full object-cover group-hover:scale-[1.03] transition"
      loading="lazy"
    />
  </div>
  <div class="p-6">
    <h3 class="text-xl font-semibold mb-2">{title}</h3>
    <p class="text-muted">{desc}</p>
  </div>
</article>
