---
import { STATS } from "../lib/constants";
---

<section class="bg-accent text-background py-14 md:py-20">
  <div
    class="container grid grid-cols-2 md:grid-cols-4 gap-8 md:gap-6 text-center"
    data-reveal
  >
    {STATS.map((s) => (
      <div>
        <p class="font-display font-extrabold text-4xl md:text-6xl leading-none">
          {s.value}
        </p>
        <p class="mt-2 text-sm md:text-base font-medium opacity-80">
          {s.label}
        </p>
      </div>
    ))}
  </div>
</section>
