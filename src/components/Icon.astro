---
const { name } = Astro.props as { name: string };
const n = String(name || '').toLowerCase();
---

{(n.includes('terrasse')) && (
  <svg viewBox="0 0 24 24" class="service-icon">
    <rect x="3" y="7" width="18" height="10" rx="1"></rect>
    <path d="M3 11h18M7 17v2m4-2v2m4-2v2"></path>
  </svg>
)}

{(n.includes('escalier')) && (
  <svg viewBox="0 0 24 24" class="service-icon">
    <path d="M4 20h16M6 20v-3h4v-3h4v-3h4V5" />
  </svg>
)}

{(n.includes('pav')) && (
  <svg viewBox="0 0 24 24" class="service-icon">
    <rect x="4" y="5" width="6" height="6" rx="1"></rect>
    <rect x="14" y="5" width="6" height="6" rx="1"></rect>
    <rect x="9" y="13" width="6" height="6" rx="1"></rect>
  </svg>
)}

{((n.includes('création') || n.includes('paysag'))) && (
  <svg viewBox="0 0 24 24" class="service-icon">
    <path d="M12 21c4-3 6-6 6-9a6 6 0 1 0-12 0c0 3 2 6 6 9zM12 7v7" />
  </svg>
)}

{(n.includes('mise en conformité')) && (
  <svg viewBox="0 0 24 24" class="service-icon">
    <path d="M4 12a8 8 0 1 1 16 0v6H4z" />
    <path d="m9 13 2 2 4-4" />
  </svg>
)}

{(n.includes('secs')) && (
  <svg viewBox="0 0 24 24" class="service-icon">
    <path d="M4 8h10M8 4v8M14 12l6 6" />
    <circle cx="20" cy="18" r="2" />
  </svg>
)}

{((n.includes('humides') || n.includes('réseaux hum'))) && (
  <svg viewBox="0 0 24 24" class="service-icon">
    <path d="M12 3c4 5 6 8 6 10a6 6 0 0 1-12 0c0-2 2-5 6-10z" />
  </svg>
)}

{(n.includes('citerne')) && (
  <svg viewBox="0 0 24 24" class="service-icon">
    <rect x="4" y="7" width="16" height="10" rx="2" />
    <path d="M8 7V5h8v2" />
  </svg>
)}

{(n.includes('maison')) && (
  <svg viewBox="0 0 24 24" class="service-icon">
    <path d="M4 12l8-6 8 6" />
    <path d="M6 10v10h12V10" />
  </svg>
)}

{(n.includes('piscine')) && (
  <svg viewBox="0 0 24 24" class="service-icon">
    <path d="M4 16c2 2 4 2 6 0s4-2 6 0 4 2 6 0" />
  </svg>
)}

{((n.includes('démolition') || n.includes('ouvrages'))) && (
  <svg viewBox="0 0 24 24" class="service-icon">
    <path d="M3 21h18" />
    <path d="M6 17l6-6 3 3 3-3" />
    <path d="M12 11V7l4-2" />
  </svg>
)}

{((n.includes('valorisation') || n.includes('tri'))) && (
  <svg viewBox="0 0 24 24" class="service-icon">
    <path d="M6 8l-2 4 4 2" />
    <path d="M18 8 20 12l-4 2" />
    <path d="M8 18h8" />
  </svg>
)}

{(!(
  n.includes('terrasse') || n.includes('escalier') || n.includes('pav') ||
  n.includes('création') || n.includes('paysag') || n.includes('mise en conformité') ||
  n.includes('secs') || n.includes('humides') || n.includes('réseaux hum') ||
  n.includes('citerne') || n.includes('maison') || n.includes('piscine') ||
  n.includes('démolition') || n.includes('ouvrages') || n.includes('valorisation') || n.includes('tri')
)) && (
  <svg viewBox="0 0 24 24" class="service-icon">
    <circle cx="12" cy="12" r="8" />
  </svg>
)}
