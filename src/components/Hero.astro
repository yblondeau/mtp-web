---
import { Image } from "astro:assets";
import { SITE } from "../lib/constants";
import heroImage from "../assets/images/hero.jpg";
---

<section class="relative isolate pt-24 md:pt-32 overflow-hidden text-center">
  {
    /* `isolate` crée un contexte d'empilement pour que le -z-10 ne passe pas derrière le body */
  }
  <div class="absolute inset-0 -z-10 parallax diagonal-bottom" data-parallax data-speed="0.18">
    <Image
      src={heroImage}
      alt="Chantier TP"
      class="w-full h-full object-cover opacity-70"
      loading="eager"
      fetchpriority="high"
    />
  </div>
  <div class="container min-h-[80vh] flex flex-col justify-center items-center relative z-10 text-center">
    <h1 class="font-display split-lines text-6xl md:text-8xl font-extrabold max-w-3xl uppercase" data-reveal>
      Marmier TP<br/> Travaux publics
  </h1>
      <p class="mt-6 max-w-2xl text-lg text-muted" data-reveal>
        Aménagements extérieurs • Assainissement • Terrassement • Démolition & recyclage
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-4" data-reveal>
        <a class="btn-solid" href={`${SITE.base}contact`}>Demander un devis</a>
        <a class="btn border-foreground/30" href={`${SITE.base}#services`}
          >Nos activités</a
        >
      </div>
  </div>
</section>
